        <mxCell id="gLFoUS87KLtoZV-xjacL-1" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;DeviceStatusUpdater&lt;/b&gt; (&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Background services)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;code&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; background-color: transparent;&quot;&gt;Run every day at&amp;nbsp;&lt;/span&gt;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; background-color: transparent;&quot;&gt;00:01&lt;/strong&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; background-color: transparent;&quot;&gt;&amp;nbsp;and call&amp;nbsp;&lt;/span&gt;&lt;code style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;CheckBookingsAndUpdateStatus&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-family: Helvetica;&quot;&gt;Run every day at&amp;nbsp;&lt;/span&gt;&lt;strong style=&quot;font-family: Helvetica;&quot;&gt;11:30&lt;/strong&gt;&lt;span style=&quot;font-family: Helvetica;&quot;&gt;&amp;nbsp;and call&amp;nbsp;&lt;/span&gt;&lt;code&gt;CheckOverdueDevices&lt;/code&gt;&lt;/li&gt;&lt;/code&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-895" y="460" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gLFoUS87KLtoZV-xjacL-2" value="&lt;div&gt;&lt;b&gt;&lt;code&gt;ActivityService&lt;/code&gt; &lt;/b&gt;will contain the core logic for:&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;li style=&quot;&quot;&gt;Checking and updating bookings (&lt;code&gt;CheckBookingsAndUpdateStatus&lt;/code&gt;).&lt;/li&gt;&lt;li style=&quot;&quot;&gt;Checking and updating overdue devices (&lt;code&gt;CheckOverdueDevices&lt;/code&gt;).&lt;/li&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
