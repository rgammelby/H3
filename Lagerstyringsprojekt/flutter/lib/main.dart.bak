import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:provider/provider.dart';
import 'package:qr_scan/pages/user/return_device_page.dart';
import 'dart:io';
import 'pages/shared/login_page.dart';
import 'pages/shared/home_page.dart';
import 'services/global/shake_toggle_theme.dart';
import 'theme/theme_provider.dart';

void main() {
  WidgetsFlutterBinding.ensureInitialized();

  SystemChrome.setPreferredOrientations([
    DeviceOrientation.portraitUp,
    DeviceOrientation.portraitDown,
  ]).then((_) {
    HttpOverrides.global = MyHttpOverrides();
    runApp(
      ChangeNotifierProvider(
        create: (_) => ThemeProvider(),
        child: MyApp(),
      ),
    );
  });
}

class MyApp extends StatefulWidget {
  @override
  State<MyApp> createState() => _MyAppState();
}

class _MyAppState extends State<MyApp> {
  late ShakeToggleTheme _shakeService;

  @override
  void initState() {
    super.initState();
    _shakeService = ShakeToggleTheme(
      onShakeDetected: _toggleTheme,
    );
    _shakeService.startListening();
  }

  @override
  void dispose() {
    _shakeService.stopListening();
    super.dispose();
  }

  void _toggleTheme() {
    final themeProvider = Provider.of<ThemeProvider>(context, listen: false);
    themeProvider.toggleBetweenThemes();

    // Add logging to check the currently applied theme
    print('Theme toggled!');
    print('Current Theme Brightness: ${themeProvider.currentTheme.brightness}');
    print('Current Theme Secondary Color: ${themeProvider.currentTheme.colorScheme.secondary}');
  }

  @override
  Widget build(BuildContext context) {
    return Consumer<ThemeProvider>(
      builder: (context, themeProvider, child) {
        // Log the current theme at build time
        print('Building MaterialApp with current theme...');
        print('Theme Brightness: ${themeProvider.currentTheme.brightness}');
        print('Secondary Color: ${themeProvider.currentTheme.colorScheme.secondary}');

        return MaterialApp(
          title: 'Device Management App',
          theme: themeProvider.currentTheme,
          darkTheme: themeProvider.themeB,
          themeMode: ThemeMode.light, // You can change this to ThemeMode.system to test toggling
          initialRoute: '/login',
          routes: {
            '/login': (context) => LoginPage(),
            '/return': (context) => ReturnDevicePage(userID: 0),
            '/home': (context) => HomePage(role: 'User', userID: 0),
          },
          debugShowCheckedModeBanner: false,
        );
      },
    );
  }
}

class MyHttpOverrides extends HttpOverrides {
  @override
  HttpClient createHttpClient(SecurityContext? context) {
    return super.createHttpClient(context)
      ..badCertificateCallback = (X509Certificate cert, String host, int port) => true;
  }
}
